{% macro widgets(args) %}
  {# Permission combines with each widget's slotPermissions additively:
     constrained if EITHER says so. allowAdjacent: false = positional anchor. #}
  {% set defaultPermission = {
    allowMove: true,
    allowDelete: true,
    allowDuplicate: true,
    allowEdit: true,
    allowAdd: true,
    allowAdjacent: true
  } %}
  {% set permission = defaultPermission|merge(args.permission|default({})) %}
  {#- Card index of a repeated slot (mff_widget_slot_for: the composed product card of a listing), null outside
      one. Cards > 0 are COPIES: same class + data-widget-id (instance CSS and live-patch reach them), plus
      data-mff-repeat-copy, and nothing the canvas registers — no MFF_WIDGET_START, no slot/drag/container
      attributes. data-mff-widget-root stays: it is the boundary the owner's instance CSS stops at. -#}
  {% set repeatIndex = mff_repeat_index() %}
  {% set repeatCopy = repeatIndex is not null and repeatIndex > 0 %}

  {% if args.pages is defined %}
    {% for page in args.pages %}
      {% set type = page.customType|default('') %}
      {% set lookupKey = page.templateKey|default(type) %}
      {# draftId for plugin Page, pId for SDK Page (subpages) #}
      {% set widgetDraftId = page.draftId|default(page.pId)|default('') %}
      {% set widgetInstanceId = (page.id == 0 ? widgetDraftId : page.id) %}
      {% set slotId = (page.slotId is defined and page.slotId) ? page.slotId : null %}
      {% set slotPerms = (page.slotPermissions is defined and page.slotPermissions) ? page.slotPermissions : null %}
      {% set payload = {
        type: type,
        id: widgetDraftId|default(page.id)|default(''),
        draftId: widgetDraftId,
        parentId: (page.parentId is defined ? page.parentId : null),
        label: (page.label is defined ? page.label : null),
        slotId: slotId
      } %}

      {% set twigCode = args.widgetTemplateList[lookupKey]|default(args.widgetTemplateList[type]) %}
      {% if twigCode is not empty %}
        {#- Slot contract published to the canvas (informe 14-09-2026 §4.1.4), every attribute derived from the WidgetDTO:
            data-mff-container    — the widget is a free container (template acceptsChildren): ordinary widgets drop inside.
            data-mff-scoped       — "1" when the template declares childStructure or slots (instance CSS scoped with :not(),
                                    the same hasSlot the CSS generator uses), "0" otherwise. Always present: the canvas reads it,
                                    it never guesses.
            data-mff-content-scope="owner" + data-mff-owner-id — slot contentScope OWNER: the occupant's content only
                                    reparents within the subtree of the widget that declares the slot (ownerId).
            data-mff-accepts      — comma-separated families the slot admits (empty = any, attribute omitted).
            data-mff-no-drag      — allowMove false OR locked.
            data-mff-locked       — lockedWhen holds on the owner: CASCADES, a widget cannot be dragged if it or ANY
                                    ancestor wrapper carries it (an integrated controls group locks its arrows too).
            data-mff-store-role / data-mff-store-root — a node of a store-widget instance. The
                                    instance behaves as ONE block: its root is what moves, deletes and duplicates; its
                                    locked and exposed pieces cannot be dragged, deleted or duplicated and are never a
                                    drop target (no data-mff-container); only its holes (slot) take content. -#}
        {% set slotLocked = slotPerms and slotPerms.locked is defined and slotPerms.locked %}
        {% set storeRole = page.storeRole is defined and page.storeRole ? page.storeRole : null %}
        {% set storeRoot = (page.storeRoot is defined and page.storeRoot) or (page.storeWidgetRef is defined and page.storeWidgetRef) %}
        {% set storeFixed = storeRole == 'locked' or storeRole == 'exposed' %}
        {% set storeInner = storeFixed and not storeRoot %}
        {% if repeatCopy %}
        <div class="mff-widget" data-widget-id="{{ widgetInstanceId }}" data-mff-repeat-copy="1"
          {%- if slotId or (page.autoGenerated is defined and page.autoGenerated is same as(false)) %} data-mff-widget-root="1"{% endif %}>
          {{ include(template_from_string(twigCode), {
              page: page,
              moduleType: type,
              moduleSettings: page.moduleSettings|default([]),
              widgetId: widgetInstanceId,
              repeatIndex: repeatIndex,
              version: args.version,
              widgetTemplateList: args.widgetTemplateList|default({}),
              shared: args.shared|default({}),
              permission: permission,
              mff_api: mff_widget_api(),
          }, sandboxed = true) }}{# the widget renders sandboxed: WidgetSecurityPolicy. The comment eats the newline the old include tag ate. #}
        </div>
        {% else %}
        <div class="mff-widget" data-widget-id="{{ widgetInstanceId }}"
          {#- data-mff-widget-root = a REAL widget nested in another one: a slot occupant, or a free child of a container
              (autoGenerated explicitly false). It is the boundary both the instance CSS exclusion
              (`:not(owner [data-mff-widget-root] [data-mff-el])`) and the canvas live-patch stop at, so an owner's
              styles never reach a nested widget that shares an element name (a column group's `top` on its `root`
              used to push down the newsletter dropped inside it). childStructure pseudo children (autoGenerated true,
              no slotId) stay unmarked on purpose: their owner styles them. An unknown autoGenerated (null) keeps the
              old behaviour rather than cutting a pseudo child off from its owner's styles. -#}
          {%- if slotId or (page.autoGenerated is defined and page.autoGenerated is same as(false)) %} data-mff-widget-root="1"{% endif %}
          {%- if slotId %} data-mff-slot-id="{{ slotId }}"{% endif %}
          {#- always 1 or 0: the canvas reads it and never deduces it #} data-mff-scoped="{{ page.scoped is defined and page.scoped ? '1' : '0' }}"
          {%- if storeRole %} data-mff-store-role="{{ storeRole }}"{% endif %}
          {%- if storeRoot %} data-mff-store-root="1"{% endif %}
          {%- if page.acceptsChildren is defined and page.acceptsChildren and not storeFixed and not storeRoot %} data-mff-container="1"{% endif %}
          {%- if slotPerms and slotPerms.contentScope is defined and slotPerms.contentScope == 'OWNER' %} data-mff-content-scope="owner"{% if slotPerms.ownerId is defined and slotPerms.ownerId %} data-mff-owner-id="{{ slotPerms.ownerId }}"{% endif %}{% endif %}
          {%- if slotPerms and slotPerms.accepts is defined and slotPerms.accepts is not empty %} data-mff-accepts="{{ slotPerms.accepts|join(',') }}"{% endif %}
          {%- if not permission.allowMove or (slotPerms and not slotPerms.allowMove) or slotLocked or storeInner %} data-mff-no-drag="1"{% endif %}
          {%- if slotLocked %} data-mff-locked="1"{% endif %}
          {%- if not permission.allowDelete or (slotPerms and not slotPerms.allowDelete) or storeInner %} data-mff-no-delete="1"{% endif %}
          {%- if not permission.allowDuplicate or (slotPerms and not slotPerms.allowDuplicate) or storeInner %} data-mff-no-duplicate="1"{% endif %}
          {%- if not permission.allowEdit %} data-mff-no-edit="1"{% endif %}
          {%- if not permission.allowAdd %} data-mff-no-add="1"{% endif %}
          {%- if not permission.allowAdjacent %} data-mff-no-adjacent="1"{% endif %}>
          <!-- MFF_WIDGET_START {{ payload|json_encode(8)|raw }}{# 8 = JSON_HEX_TAG: constant() is closed in the widget sandbox #} -->
          {{ include(template_from_string(twigCode), {
              page: page,
              moduleType: type,
              moduleSettings: page.moduleSettings|default([]),
              widgetId: widgetInstanceId,
              repeatIndex: repeatIndex,
              version: args.version,
              widgetTemplateList: args.widgetTemplateList|default({}),
              shared: args.shared|default({}),
              permission: permission,
              mff_api: mff_widget_api(),
          }, sandboxed = true) }}{# the widget renders sandboxed: WidgetSecurityPolicy. The comment eats the newline the old include tag ate. #}
          <!-- MFF_WIDGET_END -->
        </div>
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endmacro %}
