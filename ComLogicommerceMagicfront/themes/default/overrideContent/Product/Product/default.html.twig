{%- extends layout -%}

{%- block headContent -%}
    {{ parent() }}
    {%- if mffDesignCssUrl is defined and mffDesignCssUrl|length -%}
        <link rel="stylesheet" href="{{ mffDesignCssUrl }}">
    {%- endif -%}
{%- endblock -%}

{%- block jsAssets -%}
    {{ parent() }}
    {%- if mffDesignJsUrl is defined and mffDesignJsUrl|length -%}
        <script src="{{ mffDesignJsUrl }}" defer></script>
    {%- endif -%}
{%- endblock -%}

{%- block modals -%}
    {%- include 'mff-snippets/product/mff_productContact.html.twig' with { formProductContact: formProductContact } -%}
    {%- include 'mff-snippets/product/mff_itemRecommend.html.twig' with {
        formRecommend: formProductRecommend,
        type: constant('SDK\\Enums\\RecommendItemType::PRODUCT')|lower,
    } -%}
    {%- if themeConfiguration.commerce.showBundles and formBundleRecommend is defined -%}
        {%- include 'mff-snippets/product/mff_itemRecommend.html.twig' with {
            formRecommend: formBundleRecommend,
            type: constant('SDK\\Enums\\RecommendItemType::BUNDLE')|lower,
        } -%}
    {%- endif -%}
    {%- include 'mff-snippets/product/mff_productComments.html.twig' with { formProductComments: formProductComments } -%}
    {%- if themeConfiguration.commerce.showDiscounts and mainProductDiscounts is defined and mainProductDiscounts|length and controllerItem.definition.showDiscounts -%}
        {%- include 'mff-snippets/product/mff_productDiscounts.html.twig' with { productDiscounts: mainProductDiscounts } -%}
    {%- endif -%}
{%- endblock modals -%}

{%- block richSnippets -%}
    {%- import macrosCore.product as productMacros -%}
    {%- if productRichSnippets is defined and productRichSnippets|length -%}
        {{- productMacros.richSnippets({ richSnippets: productRichSnippets }) -}}
    {%- endif -%}
{%- endblock -%}

{%- block content -%}
    {# Config-driven assembly. mffDesignConfig is the resolved product design
       config (per-component snippet paths) set by RendersDesignAssetsTrait. #}
    {%- set cfg = mffDesignConfig -%}
    {%- set product = controllerItem -%}

    {# Dynamic category color (197): inlined here since the store layout has no
       categoryMainColor block. Sourced from rootCategory customTag position 2. #}
    {%- if cfg.categoryColor and rootCategory is defined -%}
        {%- set categoryColor = rootCategory.customTagValues|filter(customTag => customTag.position == 2) -%}
        {%- if categoryColor|length and categoryColor|first.value|length -%}
            <style>:root { --category-color: {{ categoryColor|first.value }}; }</style>
        {%- endif -%}
    {%- endif -%}

    {# Breadcrumb (197 renders it at the top; store layout has no preHeaderContent). #}
    {%- if cfg.breadcrumb -%}
        {%- include cfg.breadcrumb -%}
    {%- endif -%}

    <div class="{{ classes('section', 'mff-product-page', { 'offer-true': product.definition.offer, 'featured-true': product.definition.featured }) }}">
        {%- if cfg.pageTop -%}
            {%- include cfg.pageTop with {
                product: product,
                productTopPages: productTopPages|default([]),
            } -%}
        {%- endif -%}

        {%- if themeConfiguration.commerce.showBundles and productBundles is defined -%}
            {%- include 'mff-snippets/product/mff_productBundles.html.twig' with { productBundles: productBundles } -%}
        {%- endif -%}

        {%- if cfg.pageBottom -%}
            {%- include cfg.pageBottom with {
                product: product,
                productBottomPages: productBottomPages|default([]),
                showRelatedsBtn: (relatedProductItems|default([])|length and relatedProductItems|first.products|length) or (randomProducts is defined and randomProducts.items|length),
            } -%}
        {%- endif -%}

        {%- if cfg.relatedSlider -%}
            {%- if relatedProductItems|default([])|length and relatedProductItems|first.products|length -%}
                {%- include cfg.relatedSlider with {
                    products: relatedProductItems|first.products,
                    titleNode: 'div',
                    titleClass: 'h3 mff-product-bottom-title',
                    titleText: relatedProductItems|first.name,
                    id: 'product-relateds',
                    pl: cfg.productList,
                } -%}
            {%- elseif randomProducts is defined and randomProducts.items|length -%}
                {%- include cfg.relatedSlider with {
                    products: randomProducts.items,
                    titleNode: 'div',
                    titleClass: 'h3 mff-product-bottom-title',
                    titleText: languageSheet[constant('SITE\\Enums\\LanguageLabels::RANDOM_PRODUCTS_TITLE')],
                    id: 'product-relateds',
                    pl: cfg.productList,
                } -%}
            {%- endif -%}
        {%- endif -%}
    </div>
{%- endblock content -%}
