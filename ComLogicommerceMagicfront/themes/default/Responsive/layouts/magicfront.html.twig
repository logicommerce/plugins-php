{# MagicFront chrome overlay. Override header/footer when BO toggles are on; parent() otherwise.
   Unique filename avoids self-recursion when extending merchant's default. #}
{%- extends "Responsive/layouts/default.html.twig" -%}

{% import macrosCore.widget as widgetMacros %}

{#- Trackers (consent / newsletter popups) block the canvas, so they are cleared there. The
    standalone preview tab is a real storefront render and keeps them. -#}
{%- if mff_isCanvasMode() -%}
    {%- set trackers = { 'items': [] } -%}
{%- endif -%}

{%- block headContent -%}
    {{ parent() }}
    {%- if mffOverrideHeader|default(false) and mffHeaderCss|default('')|length -%}
        <style id="mff-chrome-header-css">{{ mffHeaderCss|raw }}</style>
    {%- endif -%}
    {%- if mffOverrideFooter|default(false) and mffFooterCss|default('')|length -%}
        <style id="mff-chrome-footer-css">{{ mffFooterCss|raw }}</style>
    {%- endif -%}
    {%- if mffAccountPanelCss|default('')|length -%}
        <style id="mff-account-panel-css">{{ mffAccountPanelCss|raw }}</style>
    {%- endif -%}
    {%- if mffBasketPanelCss|default('')|length -%}
        <style id="mff-basket-panel-css">{{ mffBasketPanelCss|raw }}</style>
    {%- endif -%}
    {%- if mffMobileMenuPanelCss|default('')|length -%}
        <style id="mff-mobile-menu-panel-css">{{ mffMobileMenuPanelCss|raw }}</style>
    {%- endif -%}
    {# Per-design page CSS, set by RendersDesignAssetsTrait on designable pages. #}
    {%- if mffDesignCssUrl|default('')|length -%}
        <link rel="stylesheet" href="{{ mffDesignCssUrl }}">
    {%- endif -%}
{%- endblock headContent -%}

{%- block header -%}
    {%- if mffOverrideHeader|default(false) -%}
        {# Self-contained mobile-menu / login / basket panels our header's triggers open. Rendered once
           whether we emit one variant (storefront/preview) or both (canvas swap). The store theme's own
           mobileMenu snippet is deliberately NOT included: mobileMenuPanel IS our mobile menu, so the
           hamburger targets a panel we own and nothing depends on the theme's module contract.
           MFF owns the chrome, so our self-contained panels render whenever we HAVE panel content
           (the merchant designed one) — not gated by the store theme's own offcanvas config. #}
        {%- if mffMobileMenuPanelPages|default(null) -%}
            {{ widgetMacros.widgets({ pages: mffMobileMenuPanelPages, version: version, widgetTemplateList: mffMobileMenuPanelTemplateList }) }}
        {%- endif -%}
        {%- if mffBasketPanelPages|default(null) -%}
            {{ widgetMacros.widgets({ pages: mffBasketPanelPages, version: version, widgetTemplateList: mffBasketPanelTemplateList }) }}
        {%- endif -%}
        {%- if mffAccountPanelPages|default(null) -%}
            {{ widgetMacros.widgets({ pages: mffAccountPanelPages, version: version, widgetTemplateList: mffAccountPanelTemplateList }) }}
        {%- endif -%}
        {# Our header, captured once and reused across the slot/template/single positions below. The
           region JS ships INSIDE only in canvas (so runScripts re-runs it on swap-in); otherwise it
           stays in jsAssets, deferred after the commerce core bundle. #}
        {%- set ourHeader -%}
            {{ widgetMacros.widgets({ pages: mffHeaderPages, version: version, widgetTemplateList: mffHeaderTemplateList }) }}
            {%- if mff_isCanvasMode() and mffHeaderJs|default('')|length -%}<script>{{ mffHeaderJs|raw }}</script>{%- endif -%}
        {%- endset -%}
        {%- if mff_isCanvasMode() -%}
            {# Canvas: both variants — active live in the slot, the other stashed in a <template> — so
               the toolbar swaps them with no reload. #}
            {%- set headerMff = mffHeader|default('0') -%}
            <div data-mff-chrome-slot="header" data-mff-active="{{ headerMff }}">
                {%- if headerMff == '1' -%}{{ ourHeader|raw }}{%- else -%}{{- parent() -}}{%- endif -%}
            </div>
            <template data-mff-chrome-alt="header">
                {%- if headerMff == '1' -%}{{- parent() -}}{%- else -%}{{ ourHeader|raw }}{%- endif -%}
            </template>
        {%- else -%}
            {{ ourHeader|raw }}
        {%- endif -%}
    {%- else -%}
        {{- parent() -}}
    {%- endif -%}
{%- endblock header -%}

{%- block footer -%}
    {%- if mffOverrideFooter|default(false) -%}
        {%- set ourFooter -%}
            {{ widgetMacros.widgets({ pages: mffFooterPages, version: version, widgetTemplateList: mffFooterTemplateList }) }}
            {%- if mff_isCanvasMode() and mffFooterJs|default('')|length -%}<script>{{ mffFooterJs|raw }}</script>{%- endif -%}
        {%- endset -%}
        {%- if mff_isCanvasMode() -%}
            {%- set footerMff = mffFooter|default('0') -%}
            <div data-mff-chrome-slot="footer" data-mff-active="{{ footerMff }}">
                {%- if footerMff == '1' -%}{{ ourFooter|raw }}{%- else -%}{{- parent() -}}{%- endif -%}
            </div>
            <template data-mff-chrome-alt="footer">
                {%- if footerMff == '1' -%}{{- parent() -}}{%- else -%}{{ ourFooter|raw }}{%- endif -%}
            </template>
        {%- else -%}
            {{ ourFooter|raw }}
        {%- endif -%}
    {%- else -%}
        {{- parent() -}}
    {%- endif -%}
{%- endblock footer -%}

{%- block jsAssets -%}
    {%- if mff_isCanvasMode() -%}
        {{- includeJsAssets([
            TOOLS_CORE_PATH ~ '/jquery-3.7.0.min.js', 
            TOOLS_CORE_PATH ~ '/bootstrap/5.3.1/bootstrap.bundle.min.js',
        ]) -}}
        {{- includeJsAssets(ASSETS_ENVIRONMENT_COMMERCE, 'default') -}} 
    {%- else -%}
        {{ parent() }}
    {%- endif -%}
    {# In canvas preview the region JS ships INSIDE the <template> so runScripts re-runs it on
       swap-in; emitting it here too would run it at load against the not-yet-live DOM. #}
    {%- if mffOverrideHeader|default(false) and mffHeaderJs|default('')|length and not mff_isCanvasMode() -%}
        <script id="mff-chrome-header-js">{{ mffHeaderJs|raw }}</script>
    {%- endif -%}
    {%- if mffOverrideFooter|default(false) and mffFooterJs|default('')|length and not mff_isCanvasMode() -%}
        <script id="mff-chrome-footer-js">{{ mffFooterJs|raw }}</script>
    {%- endif -%}
    {%- if mffAccountPanelJs|default('')|length -%}
        <script id="mff-account-panel-js">{{ mffAccountPanelJs|raw }}</script>
    {%- endif -%}
    {%- if mffBasketPanelJs|default('')|length -%}
        <script id="mff-basket-panel-js">{{ mffBasketPanelJs|raw }}</script>
    {%- endif -%}
    {%- if mffMobileMenuPanelJs|default('')|length -%}
        <script id="mff-mobile-menu-panel-js">{{ mffMobileMenuPanelJs|raw }}</script>
    {%- endif -%}
    {# Per-design page JS, set by RendersDesignAssetsTrait on designable pages.
       Deferred so it runs after the store's deferred commerce 'core' bundle. #}
    {%- if mffDesignJsUrl|default('')|length -%}
        <script src="{{ mffDesignJsUrl }}" defer></script>
    {%- endif -%}
{%- endblock jsAssets -%}
