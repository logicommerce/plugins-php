{#- 
    @version 2
    @description One row with orderby + filters in a single big dropdown.

    @param {ElementCollection<Product>} products
    @param {bool} filtering

    @param {array} productsFilter Global scope variable. Source of var: FWK/src/Core/Controllers/FiltrableProductListTrait.php
    @param {Pagination} paginationData Global scope variable. Source of var: SITE/src/Core/Controllers/Traits/ProductsFilterModuleDataProviderTrait.php
    @param {ItemList} itemListData Global scope variable. Source of var: SITE/src/Core/Controllers/Traits/ProductsFilterModuleDataProviderTrait.php

    @example 
        {%- include version ~ '/snippets/productsFilter/productsFilter03.html.twig' -%}

    @see SITE/assets/commerce/css/modules/productsFilter03.css
    @see SITE/assets/commerce/js/modules/productsFilter03.js
-#}

{%- if products is defined -%}
    {%- import macrosCore.product as productMacros -%}
    {%- import macrosCore.util as utilMacros -%}

    {%- set showFiltersBlock = true -%}
    {%- set showOrderByBlock = true -%}
    {%- set moduleRowsCount = 2 -%}

    {%- if not filtering and paginationData.totalItems < 2 -%}
        {%- set showFiltersBlock = false -%}
        {%- set moduleRowsCount = moduleRowsCount - 1 -%}
    {%- endif -%}

    {%- if paginationData.totalItems < 2 -%}
        {%- set showOrderByBlock = false -%}
        {%- set moduleRowsCount = moduleRowsCount - 1 -%}
    {%- endif -%}

    {%- set autoSubmitFilterForm = false -%}

    {%- if showFiltersBlock or showOrderByBlock -%}
        <section class="{{ classes('module module-no-space mff-module-products-filter mff-module-products-filter-03', 'mff-block-rows-' ~ moduleRowsCount, { 'filtering': filtering, 'autosubmit' : autoSubmitFilterForm }) }}" data-module="productsFilter03">
            <div class="wrap-container mff-module-products-filter-content">
                <div class="mff-filter-row-desktop container-md d-none d-lg-block">
                    <div class="mff-filter-row-content">
                        {%- if showOrderByBlock -%}
                            <div class="order-by-dropdown">
                                <div class="dropdown">
                                    <button class="btn btn-link btn-filter dropdown-toggle" type="button" id="dOrderBy" data-bs-toggle="dropdown" data-bs-offset="0,0" aria-expanded="false">
                                        <span class="name">
                                            {{- languageSheet[constant('SITE\\Enums\\LanguageLabels::ORDER_BY')] -}}
                                        </span>
                                        <svg class="icon"><use xlink:href="#icon-angle-down"></use></svg>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-start" aria-labelledby="dOrderBy">
                                        {{- utilMacros.viewSection({
                                            itemList: itemListData,
                                            showElementsList: 'sort', 
                                        }) -}}
                                    </div>
                                </div>
                            </div>
                        {%- endif -%}

                        {%- if showFiltersBlock -%}
                            <div class="mff-filter-by-dropdown">
                                <div class="dropdown">
                                    <button class="btn btn-link btn-filter dropdown-toggle" type="button" id="dFilterBy" data-bs-toggle="dropdown" data-bs-offset="0,0" data-bs-auto-close="outside" aria-expanded="false">
                                        <span class="name">{{- languageSheet[constant('SITE\\Enums\\LanguageLabels::FILTER_BY')] -}}</span>
                                        <span class="n-total-applied-filter n-0"></span>
                                        <svg class="icon"><use xlink:href="#icon-angle-down"></use></svg>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end content-filters-place-desktop" aria-labelledby="dFilterBy">
                                        <div class="accordion content-filters-to-move" id="accordion-filter-03">
                                            {%- set filterItemTemplate -%}
                                                {%- set blockClassWildcard = '{{blockClassWildcard}}' -%}
                                                {%- set uidWildcard = '{{uidWildcard}}' -%}
                                                {%- set nameWildcard = '{{nameWildcard}}' -%}
                                                {%- set badgeAppliedFiltersWildcard = '{{badgeAppliedFiltersWildcard}}' -%}
                                                {%- set elementsWildcard = '{{elementsWildcard}}' -%}

                                                <div class="filter-block-wrap accordion-item mff-filterBlock {{ blockClassWildcard }}">
                                                    <button id="heading-{{ uidWildcard }}" data-bs-toggle="collapse" data-bs-target="#collapse-{{ uidWildcard }}" aria-expanded="false" aria-controls="collapse-{{ uidWildcard }}" type="button" class="btn-filter accordion-button collapsed d-lg-none">
                                                        <span class="name">{{- nameWildcard -}}</span>
                                                        {{- badgeAppliedFiltersWildcard -}}
                                                        <svg class="icon"><use xlink:href="#icon-angle-down"></use></svg>
                                                    </button>

                                                    <div id="collapse-{{ uidWildcard }}" class="accordion-collapse collapse no-collapse-lg no-collapse-xl no-collapse-xxl" role="tabpanel" aria-labelledby="heading-{{ uidWildcard }}" data-bs-parent="#accordion-filter-03">
                                                        <div class="mff-filter-name-desktop d-none d-lg-block">
                                                            <span class="name">{{- nameWildcard -}}</span>
                                                            {{- badgeAppliedFiltersWildcard -}}
                                                        </div>

                                                        <div class="mff-inset-filter-elements">
                                                            {{- elementsWildcard -}}
                                                        </div>
                                                    </div>
                                                </div>
                                            {%- endset -%}
                                            {{- productMacros.filterForm({
                                                filters: products.filter,
                                                applicableFilters: applicableFiltersData,
                                                appliedFilters: productsFilter,
                                                defaultParametersValues: defaultParametersValuesData,
                                                autosubmit: autoSubmitFilterForm,
                                                filterItemTemplate: filterItemTemplate,
                                            }) -}}

                                            {{- productMacros.buttonClearProductsFilter({
                                                class: 'btn icon-clear-filter-button',
                                                show: constant('FWK\\ViewHelpers\\Product\\Macro\\ButtonClearProductsFilter::SHOW_FITLERING'),
                                                applicableFilters: applicableFiltersData,
                                                appliedFilters: productsFilter,
                                                productItems: paginationData.totalItems,
                                            }) -}}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {%- endif -%}
                    </div>
                </div>

                {%- if showFiltersBlock -%}
                    <div class="container-md d-lg-none">
                        <div class="mff-filter-by-row-mobile">
                            <span class="mff-total-products">
                                {{- languageSheet[constant('SITE\\Enums\\LanguageLabels::PRODUCT_RESULTS')]|replace({
                                    '{{items}}': paginationData.totalItems,
                                }) -}}
                            </span>
                            <div class="mff-filter-by-elements">
                                <button class="btn btn-secondary btn-menu-filter" type="button" data-bs-toggle="offcanvas" data-bs-target="#menu-filter-03" aria-controls="menu-filter-03">
                                    <svg class="icon"><use xlink:href="#icon-filter"></use></svg>
                                    {{- languageSheet[constant('SITE\\Enums\\LanguageLabels::FILTER')] -}}
                                    <span class="n-total-applied-filter n-0"></span>
                                </button>
                                {%- set buttonClearProductsFilter -%}
                                    {{- productMacros.buttonClearProductsFilter({
                                        class: 'btn btn-danger btn-menu-filter-close',
                                        show: constant('FWK\\ViewHelpers\\Product\\Macro\\ButtonClearProductsFilter::SHOW_FITLERING'),
                                        applicableFilters: applicableFiltersData,
                                        appliedFilters: productsFilter,
                                        productItems: paginationData.totalItems,
                                    }) -}}
                                {%- endset -%}
                                {{- buttonClearProductsFilter|preg_replace('/(<a[^>]*>)(.+?)(<\\/a>)/', '$1<svg class="icon"><use xlink:href="#icon-close"></use></svg>$3') -}}
                            </div>
                        </div>
                    </div>
                {%- endif -%}
            </div>
        </section>
    {%- endif -%}
    
    <div class="offcanvas offcanvas-start" tabindex="-1" id="menu-filter-03" aria-labelledby="menu-filter-03-label">
        <div class="offcanvas-header">
            <div class="offcanvas-title" id="menu-filter-03-label">{{- languageSheet[constant('SITE\\Enums\\LanguageLabels::FILTER_MENU_TITLE')] -}}</div>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="{{- languageSheet[constant('SITE\\Enums\\LanguageLabels::CLOSE')] -}}"></button>
        </div>
        <div class="offcanvas-body mff-module-products-filter-content">
            <div class="accordion-item">
                <button id="heading-orderBy" data-bs-toggle="collapse" data-bs-target="#collapse-orderBy" aria-expanded="false" aria-controls="collapse-orderBy" type="button" class="btn-filter accordion-button collapsed">
                    <span class="name">{{- languageSheet[constant('SITE\\Enums\\LanguageLabels::ORDER_BY')] -}}</span>
                    <svg class="icon"><use xlink:href="#icon-angle-down"></use></svg>
                </button>

                <div id="collapse-orderBy" class="accordion-collapse collapse" role="tabpanel" aria-labelledby="heading-orderBy" data-bs-parent="#__accordionId__">
                    <div class="mff-inset-filter-elements">
                        {{- utilMacros.viewSection({
                            itemList: itemListData,
                            showElementsList: 'sort',
                        }) -}}
                    </div>
                </div>
            </div>
            <div class="content-filters-place-mobile">
                {#- Filters move inside this div by module JS -#}
            </div>
        </div>
        {%- if (autoSubmitFilterForm and filtering) or not autoSubmitFilterForm -%}
            <div class="offcanvas-footer">
                {%- set buttonClearProductsFilter -%}
                    {{- productMacros.buttonClearProductsFilter({
                        class: 'btn btn-secondary',
                        show: constant('FWK\\ViewHelpers\\Product\\Macro\\ButtonClearProductsFilter::SHOW_FITLERING'),
                        applicableFilters: applicableFiltersData,
                        appliedFilters: productsFilter,
                        productItems: paginationData.totalItems,
                    }) -}}
                {%- endset -%}
                {%- set label = languageSheet[constant('SITE\\Enums\\LanguageLabels::CLEAR_FILTER_SHORT')] -%}
                {{- buttonClearProductsFilter|preg_replace('/(<a[^>]*>)(.+?)(<\\/a>)/', '$1' ~ label ~ '$3') -}}
                {%- if not autoSubmitFilterForm -%}
                    <button class="btn btn-primary filter-form-submit-custom" type="button">{{- languageSheet[constant('SITE\\Enums\\LanguageLabels::APPLY_FILTERS')] -}}</button>
                {%- endif -%}
            </div>
        {%- endif -%}
    </div>
{%- endif -%}